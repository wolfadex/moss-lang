# if: ([...] [...] -> ... Bool)
# elif: (Bool [...] [...] -> ... Bool)
# else: (Bool [...] [...] -> ...)
# iff: ([...] [...] -> ...)
#
# @tag
#
# { foo: 1, bar: "carl" }
# [ [1 "foo"] ["carl" "bar"] ]
#
# { foo: 1, bar: "carl" } .foo # 1
# { foo: 1, bar: "carl" } "foo" get
#
# { foo: 1, bar: "carl" } 2 ^foo # { foo: 2, bar: "carl" }
# { foo: 1, bar: "carl" } 2 "foo" put
#
# [ "foo" "bar" "baz" ] 0 at # "foo"
#